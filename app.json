{
  "expo": {
    "name": "Tydee",
    "slug": "tydee-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Assets/Icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./Assets/Icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B5CF6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tydee.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./Assets/adaptive-icon.png",
        "backgroundColor": "#8B5CF6"
      },
      "package": "com.tydee.mobile"
    },
    "web": {
      "favicon": "./Assets/favicon.png"
    },
    "scheme": "tydee",
    "extra": {
      
    }
  }
}
